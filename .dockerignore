# Keeps the Docker build context lean for server/Dockerfile - the build
# context is always the repo root (needs core/, the root pom.xml, assets/,
# and .git/ - the last one deliberately NOT excluded here, jgitver (design.md
# 3.10) needs the real commit/tag history to compute the image's version).
target/
core/target/
lwjgl3/target/
server/target/
dev-tools/target/
.idea/
_gradle-legacy-backup/
