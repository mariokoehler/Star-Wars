<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.mkoehler.starwars</groupId>
  <artifactId>starwars-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <name>StarWars</name>
  <description>A libGDX project.</description>

  <modules>
    <module>core</module>
    <module>lwjgl3</module>
    <module>server</module>
    <module>dev-tools</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <appName>StarWars</appName>
    <gdxVersion>1.14.2</gdxVersion>
    <ashleyVersion>1.7.4</ashleyVersion>
    <!-- Forces LWJGL3 to this version, to avoid warnings on Java 25 and up. -->
    <lwjgl3Version>3.4.3</lwjgl3Version>
    <!-- Maintained KryoNet fork, see design.md 3.4 -->
    <kryonetVersion>2.22.9</kryonetVersion>
    <!-- JUnit 5, see CLAUDE.md "Code style & testing" -->
    <junitVersion>5.14.4</junitVersion>
    <!-- JSON handling, see design.md 3.9 -->
    <jacksonVersion>2.22.2</jacksonVersion>
    <!-- Menu-style screens' UI toolkit, see design.md 4.4 - first real usage: Connect Dialog. -->
    <visUiVersion>1.5.9</visUiVersion>
  </properties>

  <!-- The KryoNet fork is only published on JitPack, not Maven Central. -->
  <repositories>
    <repository>
      <id>jitpack.io</id>
      <url>https://jitpack.io</url>
    </repository>
  </repositories>

