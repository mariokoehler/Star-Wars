<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.mkoehler.starwars</groupId>
    <artifactId>starwars-parent</artifactId>
    <version>0</version>
  </parent>

  <artifactId>starwars-core</artifactId>
  <packaging>jar</packaging>
  <name>StarWars-core</name>

  <dependencies>
    <dependency>
      <groupId>com.badlogicgames.gdx</groupId>
      <artifactId>gdx</artifactId>
      <version>${gdxVersion}</version>
    </dependency>
    <dependency>
      <groupId>com.badlogicgames.gdx</groupId>
      <artifactId>gdx-box2d</artifactId>
      <version>${gdxVersion}</version>
    </dependency>
    <dependency>
      <!-- Official libGDX extension for loading real .ttf files (FreeTypeFontGenerator) -
           the base `gdx` artifact only supports pre-baked BitmapFonts. Needs its own natives,
           see gdx-freetype-platform in lwjgl3/pom.xml (same class of gotcha as gdx-platform/
           gdx-box2d-platform, see CLAUDE.md "Maven + libGDX gotchas"). -->
      <groupId>com.badlogicgames.gdx</groupId>
      <artifactId>gdx-freetype</artifactId>
      <version>${gdxVersion}</version>
    </dependency>
    <dependency>
      <groupId>com.badlogicgames.ashley</groupId>
      <artifactId>ashley</artifactId>
      <version>${ashleyVersion}</version>
    </dependency>
    <dependency>
      <groupId>com.github.crykn</groupId>
      <artifactId>kryonet</artifactId>
    </dependency>
    <dependency>
      <!-- See design.md 3.9 - the shared JSON library, first real usage: ship sprite
           metadata (hitbox polygon, attachment points, see design.md 4.3/2.4). -->
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <!-- See design.md 4.4 - Scene2D UI toolkit for the menu-style screens (Connect Dialog,
           Keybind Setup); built directly on Scene2D (already part of `gdx`), so it composes
           cleanly with the plain-Scene2D HUD code without pulling in anything else. -->
      <groupId>com.kotcrab.vis</groupId>
      <artifactId>vis-ui</artifactId>
      <version>${visUiVersion}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <!-- Filtering substitutes ${project.version} (jgitver-computed, design.md 3.10)
             into starwars-version.properties, read at runtime by AppVersion. -->
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <!-- Test-scoped only, unlike lwjgl3's/server's own (main-scoped) equivalent of this same
         block - core's own packaged jar must stay exactly as before (lwjgl3/server already
         bundle assets/ into their own runtime classpath, a second copy via core's jar would
         just be redundant), but a core test that touches ShipStats (e.g. ShipUnlocksTest,
         design.md - ship unlocks) needs shipdata/*.json on ITS classpath directly - a gap
         that simply never surfaced before, since no earlier core test happened to load it. -->
    <testResources>
      <testResource>
        <directory>${project.basedir}/../assets</directory>
      </testResource>
    </testResources>
  </build>
</project>
